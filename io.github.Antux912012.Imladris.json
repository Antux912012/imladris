{
    "id": "io.github.Antux912012.Imladris",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "imladris",
    "add-extensions": {
        "io.github.Antux912012.Imladris.Toolchain": {
            "directory": "toolchain",
            "version": "50",
            "add-ld-path": "lib",
            "autodelete": true,
            "no-autodownload": false
        }
    },
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--talk-name=org.freedesktop.Flatpak",
        "--filesystem=home",
        "--filesystem=xdg-cache/imladris:create",
        "--env=PATH=/app/bin:/app/toolchain/bin:/usr/bin"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "CARGO_HOME": "/run/build/imladris/cargo",
            "CARGO_NET_OFFLINE": "true"
        }
    },
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/man",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "imladris",
            "buildsystem": "meson",
            "config-opts": [
                "--buildtype=release"
            ],
            "post-install": [
                "mkdir -p /app/toolchain"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
