{
    "id": "io.github.Antux912012.Imladris",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "imladris",
    "add-extensions": {
        "io.github.Antux912012.Imladris.Toolchain": {
            "directory": "toolchain",
            "version": "50",
            "add-ld-path": "lib",
            "autodelete": true,
            "no-autodownload": true
        }
    },
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=home",
        "--filesystem=/etc/imladris:ro",
        "--talk-name=org.freedesktop.Flatpak",
        "--env=PATH=/app/bin:/app/toolchain/bin:/usr/bin"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/man",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "imladris",
            "buildsystem": "meson",
            "config-opts": [
                "--buildtype=release"
            ],
            "post-install": [
                "mkdir -p /app/toolchain"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
