# Maintainer: Antonio De Gaetano <antux912012@users.noreply.github.com>
pkgname=imladris
pkgver=0.43.0
pkgrel=1
pkgdesc="Native scientific notebook IDE for Quarto, R, Python & Jupyter with GTK4 and AI"
arch=('x86_64')
url="https://antux912012.github.io/imladris/"
license=('Apache-2.0')
depends=(
    'gtk4>=4.14'
    'libadwaita>=1.5'
    'gtksourceview5>=5.10'
    'webkitgtk-6.0'
    'libsecret'
    'libsoup3'
    'json-glib'
    'libgee'
    'glib2'
    'hicolor-icon-theme'
    'curl'
    'bzip2'
    'r'
    'python'
    'python-pip'
    'pandoc'
    'git'
)
provides=('imladris-toolchain')
conflicts=('imladris-toolchain')
replaces=('imladris-toolchain')
optdepends=(
    'python-uv: Ultra-fast Python package installer'
    'llama.cpp: Zero-config local LLM inference engine for Elrond Assistance'
    'llama-cpp: Alternative package name for local LLM inference'
    'vulkan-icd-loader: Vulkan GPU acceleration for Elrond local AI and GSK rendering'
    'quarto-cli-bin: Quarto document, slide deck, and poster rendering'
    'texlive-basic: LaTeX PDF compilation for Quarto and R Markdown'
    'libreoffice: Presentation and spreadsheet export'
)
makedepends=(
    'meson>=0.60'
    'ninja'
    'vala>=0.56'
    'pkgconf'
    'gcc'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/Antux912012/imladris/archive/refs/tags/v$pkgver.tar.gz")
# Maintainer note: run `updpkgsums` after tagging v$pkgver
sha256sums=('fd9f5816c46477bb8082e7973eeb22fa9b20c9001ba5f236760752c43e64b67c')

build() {
    cd "$srcdir/imladris-$pkgver"
    arch-meson build
    meson compile -C build
}

check() {
    cd "$srcdir/imladris-$pkgver"
    meson test -C build --print-errorlogs || true
}

package() {
    cd "$srcdir/imladris-$pkgver"
    DESTDIR="$pkgdir" meson install -C build
}
