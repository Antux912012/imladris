# Maintainer: Antonio De Gaetano <antux912012@users.noreply.github.com>
pkgname=imladris
pkgver=0.24.2
pkgrel=1
pkgdesc="Polyglot Scientific & Markdown IDE with GNOME/Libadwaita UI, Elrond AI, GPU Acceleration, and R/Python"
arch=('x86_64')
url="https://antux912012.github.io/imladris/"
license=('GPL-3.0-or-later')
depends=(
    'gtk4>=4.12'
    'libadwaita>=1.5'
    'gtksourceview5>=5.10'
    'webkitgtk-6.0'
    'libsecret'
    'libsoup3'
    'json-glib'
    'libgee'
    'glib2'
    'hicolor-icon-theme'
)
optdepends=(
    'r: R language execution and package management'
    'python: Python execution and pip integration'
    'python-uv: Ultra-fast Python package installer'
    'llama.cpp: Zero-config local LLM inference engine for Elrond Assistance'
    'llama-cpp: Alternative package name for local LLM inference'
    'vulkan-icd-loader: Vulkan GPU acceleration for Elrond local AI and GSK rendering'
    'quarto-cli-bin: Quarto document, slide deck, and poster rendering'
    'pandoc: Document export to PDF, HTML, and Word'
    'libreoffice: Presentation and spreadsheet export'
)
makedepends=(
    'meson>=0.60'
    'ninja'
    'vala>=0.56'
    'pkgconf'
    'gcc'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/Antux912012/imladris/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('e31bf0ebf27305ce9475b9ef67ef33a5b6bcbf098831a275fa28f1f9fc20de0c')

build() {
    cd "$srcdir/imladris-$pkgver"
    arch-meson build
    meson compile -C build
}

check() {
    cd "$srcdir/imladris-$pkgver"
    meson test -C build --print-errorlogs || true
}

package() {
    cd "$srcdir/imladris-$pkgver"
    DESTDIR="$pkgdir" meson install -C build
}
