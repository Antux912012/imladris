<language id="quarto" name="Quarto" version="2.0" _section="Scientific">
  <metadata>
    <property name="mimetypes">text/x-quarto;text/markdown</property>
    <property name="globs">*.qmd</property>
    <property name="line-comment-start"># </property>
  </metadata>

  <styles>
    <style id="yaml-delim" name="YAML Delimiter" map-to="def:preprocessor"/>
    <style id="chunk-fence" name="Chunk Fence" map-to="def:keyword"/>
    <style id="quarto-option" name="Quarto Option" map-to="def:special-constant"/>
    <style id="math" name="Math Formula" map-to="def:string"/>
    <style id="citation" name="Citation" map-to="def:identifier"/>
  </styles>

  <definitions>
    <context id="yaml-frontmatter" style-ref="yaml-delim">
      <start>\%^---$</start>
      <end>^(---|\.\.\.)$</end>
      <include>
        <context ref="yaml:yaml" ignore-style="true"/>
      </include>
    </context>

    <context id="quarto-option-line" style-ref="quarto-option">
      <match>^#\|.*$</match>
    </context>

    <context id="chunk-r">
      <start>^(`{3,})\s*\{\s*r\b[^}]*\}\s*$</start>
      <end>^(\%{1@start})</end>
      <include>
        <context sub-pattern="0" where="start" style-ref="chunk-fence"/>
        <context sub-pattern="0" where="end" style-ref="chunk-fence"/>
        <context ref="quarto-option-line"/>
        <context ref="r:r" ignore-style="true"/>
      </include>
    </context>

    <context id="chunk-python">
      <start>^(`{3,})\s*\{\s*(python|py)\b[^}]*\}\s*$</start>
      <end>^(\%{1@start})</end>
      <include>
        <context sub-pattern="0" where="start" style-ref="chunk-fence"/>
        <context sub-pattern="0" where="end" style-ref="chunk-fence"/>
        <context ref="quarto-option-line"/>
        <context ref="python3:python3" ignore-style="true"/>
      </include>
    </context>

    <context id="chunk-bash">
      <start>^(`{3,})\s*\{\s*(bash|sh)\b[^}]*\}\s*$</start>
      <end>^(\%{1@start})</end>
      <include>
        <context sub-pattern="0" where="start" style-ref="chunk-fence"/>
        <context sub-pattern="0" where="end" style-ref="chunk-fence"/>
        <context ref="quarto-option-line"/>
        <context ref="sh:sh" ignore-style="true"/>
      </include>
    </context>

    <context id="chunk-generic">
      <start>^(`{3,})\s*\{[a-zA-Z0-9_+-]+[^}]*\}\s*$</start>
      <end>^(\%{1@start})</end>
      <include>
        <context sub-pattern="0" where="start" style-ref="chunk-fence"/>
        <context sub-pattern="0" where="end" style-ref="chunk-fence"/>
        <context ref="quarto-option-line"/>
      </include>
    </context>

    <context id="display-math" style-ref="math">
      <start>\$\$</start>
      <end>\$\$</end>
    </context>

    <context id="inline-math" style-ref="math">
      <match>\$[^$\n]+\$</match>
    </context>

    <context id="citation" style-ref="citation">
      <match>\[@[-a-zA-Z0-9_.:; ]+\]|@[a-zA-Z][a-zA-Z0-9_.:-]*</match>
    </context>

    <context id="quarto">
      <include>
        <context ref="yaml-frontmatter"/>
        <context ref="chunk-r"/>
        <context ref="chunk-python"/>
        <context ref="chunk-bash"/>
        <context ref="chunk-generic"/>
        <context ref="display-math"/>
        <context ref="inline-math"/>
        <context ref="citation"/>
        <context ref="markdown:markdown"/>
      </include>
    </context>
  </definitions>
</language>
